<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CscCoop</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Path to the test copy of the game (never the Steam install). -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\local\game-copy</GameDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoopCore\CoopCore.csproj" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- Every interop assembly of the game (generated by BepInEx on first launch). -->
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <!-- dotnet build -p:SkipDeploy=true while a test copy is running and holds the dll. -->
  <Target Name="DeployToGameCopy" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath);$(OutDir)CoopCore.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\CscCoop" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)CoopCore.dll" DestinationFolder="$(GameDir)-2\BepInEx\plugins\CscCoop" Condition="Exists('$(GameDir)-2')" />
  </Target>

</Project>
